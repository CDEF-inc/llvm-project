; The caller extends char and short arguments (CC-RX's callee relies on
; it), and the callee extends them again (GNURX's caller does not).
declare void @sink(i8 signext, i8 zeroext, i16 signext, i16 zeroext)
define void @c_ext(i32 %x) {
; CHECK-LABEL: c_ext:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    mov.b r1, r5
; CHECK-NEXT:    movu.b r1, r2
; CHECK-NEXT:    mov.w r1, r3
; CHECK-NEXT:    movu.w r1, r4
; CHECK-NEXT:    mov.l r5, r1
; CHECK-NEXT:    bsr.a _sink
; CHECK-NEXT:    rts
  %b = trunc i32 %x to i8
  %h = trunc i32 %x to i16
  call void @sink(i8 signext %b, i8 zeroext %b, i16 signext %h, i16 zeroext %h)
  ret void
}
define i32 @p_ext(i8 signext %a, i8 zeroext %b, i16 signext %c, i16 zeroext %d) {
; CHECK-LABEL: p_ext:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    movu.w r4, r4
; CHECK-NEXT:    mov.w r3, r3
; CHECK-NEXT:    add r4, r3
; CHECK-NEXT:    movu.b r2, r2
; CHECK-NEXT:    mov.b r1, r1
; CHECK-NEXT:    add r2, r1
; CHECK-NEXT:    add r3, r1
; CHECK-NEXT:    rts
  %ea = sext i8 %a to i32
  %eb = zext i8 %b to i32
  %ec = sext i16 %c to i32
  %ed = zext i16 %d to i32
  %s1 = add i32 %ea, %eb
  %s2 = add i32 %ec, %ed
  %r = add i32 %s1, %s2
  ret i32 %r
}
