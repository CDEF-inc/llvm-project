; RUN:   | FileCheck %s --check-prefix=BAD

; BAD: RX: unknown target ABI 'foo' (expected ccrx or gnu)

; Argument placement with CC-RX's calling convention (the default; CC-RX
; manual 9.1.3): an argument that does not fit in the free registers goes on
; the stack without using them up, so later arguments still fill them. The
; expected code is what CC-RX V3.08 emits for the same calls. GNURX's
; (-target-abi=gnu) is in arg-placement.ll.

target triple = "rx-none-elf"

%s16 = type { [4 x i32] }
%s6 = type { [3 x i16] }

declare i32 @f10(i8 zeroext, i64, i64, i16 signext, i32, i8 zeroext,
                 i16 signext, i8 zeroext, i8 zeroext, i16 signext)

; The example 1 of the manual: 1 in R1, 2 in R2:R3, 3 on the stack, 4 in R4,
; and 5 to 10 on the stack after 3, each at its own size and alignment.
define i32 @c_f10() {
; CHECK-LABEL: c_f10:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    add #-20, r0, r0
; CHECK-NEXT:    mov.w #10, 18[r0]
; CHECK-NEXT:    mov.b #9, 17[r0]
; CHECK-NEXT:    mov.b #8, 16[r0]
; CHECK-NEXT:    mov.w #7, 14[r0]
; CHECK-NEXT:    mov.b #6, 12[r0]
; CHECK-NEXT:    mov.l #5, 8[r0]
; CHECK-NEXT:    mov.l #0, 4[r0]
; CHECK-NEXT:    mov.l #3, 0[r0]
; CHECK-NEXT:    mov.l #1, r1
; CHECK-NEXT:    mov.l #2, r2
; CHECK-NEXT:    mov.l #0, r3
; CHECK-NEXT:    mov.l #4, r4
; CHECK-NEXT:    bsr.a _f10
; CHECK-NEXT:    rtsd #20
  %r = call i32 @f10(i8 zeroext 1, i64 2, i64 3, i16 signext 4, i32 5,
                     i8 zeroext 6, i16 signext 7, i8 zeroext 8, i8 zeroext 9,
                     i16 signext 10)
  ret i32 %r
}

; The i64 does not fit after three ints: on the stack (+0); the int after it
; takes R4.
define i64 @p_ll(i32 %a, i32 %b, i32 %c, i64 %x, i32 %y) {
; CHECK-LABEL: p_ll:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    shar #31, r4, r3
; CHECK-NEXT:    mov.l 4[r0], r1
; CHECK-NEXT:    mov.l 8[r0], r2
; CHECK-NEXT:    add r4, r1
; CHECK-NEXT:    adc r3, r2
; CHECK-NEXT:    rts
  %e = sext i32 %y to i64
  %r = add i64 %x, %e
  ret i64 %r
}

; Two i64 after the back-filled R4: both on the stack.
declare i32 @two(i32, i32, i32, i64, i32, i64)
define i32 @c_two() {
; CHECK-LABEL: c_two:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    add #-16, r0, r0
; CHECK-NEXT:    mov.l #0, 12[r0]
; CHECK-NEXT:    mov.l #6, 8[r0]
; CHECK-NEXT:    mov.l #0, 4[r0]
; CHECK-NEXT:    mov.l #4, 0[r0]
; CHECK-NEXT:    mov.l #1, r1
; CHECK-NEXT:    mov.l #2, r2
; CHECK-NEXT:    mov.l #3, r3
; CHECK-NEXT:    mov.l #5, r4
; CHECK-NEXT:    bsr.a _two
; CHECK-NEXT:    rtsd #16
  %r = call i32 @two(i32 1, i32 2, i32 3, i64 4, i32 5, i64 6)
  ret i32 %r
}

; A 16-byte structure after an int does not fit: byval on the stack, and
; the int after it in R2.
declare i32 @s16(i32, ptr byval(%s16) align 4, i32)
define i32 @c_s16(ptr %p) {
; CHECK-LABEL: c_s16:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    add #-16, r0, r0
; CHECK-NEXT:    mov.l 12[r1], r2
; CHECK-NEXT:    mov.l r2, 12[r0]
; CHECK-NEXT:    mov.l 8[r1], r2
; CHECK-NEXT:    mov.l r2, 8[r0]
; CHECK-NEXT:    mov.l 4[r1], r2
; CHECK-NEXT:    mov.l r2, 4[r0]
; CHECK-NEXT:    mov.l [r1], r1
; CHECK-NEXT:    mov.l r1, [r0]
; CHECK-NEXT:    mov.l #1, r1
; CHECK-NEXT:    mov.l #2, r2
; CHECK-NEXT:    bsr.a _s16
; CHECK-NEXT:    rtsd #16
  %r = call i32 @s16(i32 1, ptr byval(%s16) align 4 %p, i32 2)
  ret i32 %r
}

; A byval structure (always on the stack) takes no register: the ints after
; it start at R1.
define i32 @p_s6(ptr byval(%s6) align 2 %x, i32 %y, i32 %z) {
; CHECK-LABEL: p_s6:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    sub r2, r1
; CHECK-NEXT:    rts
  %r = sub i32 %y, %z
  ret i32 %r
}

