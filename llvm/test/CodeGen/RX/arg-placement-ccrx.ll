; after it takes R4.
declare i32 @dbl(i32, i32, i32, double, float)
define i32 @c_dbl() {
; CHECK-LABEL: c_dbl:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    add #-8, r0, r0
; CHECK-NEXT:    mov.l #1074790400, 4[r0]
; CHECK-NEXT:    mov.l #0, 0[r0]
; CHECK-NEXT:    mov.l #1, r1
; CHECK-NEXT:    mov.l #2, r2
; CHECK-NEXT:    mov.l #3, r3
; CHECK-NEXT:    mov.l #1084227584, r4
; CHECK-NEXT:    bsr.a _dbl
; CHECK-NEXT:    rtsd #8
  %r = call i32 @dbl(i32 1, i32 2, i32 3, double 4.0, float 5.0)
  ret i32 %r
