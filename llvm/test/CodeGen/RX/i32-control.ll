; CHECK-NEXT:    bgt .LBB1_2
; CHECK-NEXT:  ; %bb.1: ; %base
; CHECK-NEXT:    rtsd #8, r6-r7
; CHECK-NEXT:  .LBB1_2: ; %rec
; CHECK-NEXT:    add #-1, r1, r2
; CHECK-NEXT:    mov.l r1, r7
; CHECK-NEXT:    mov.l r2, r1
; CHECK-NEXT:    bsr.a _t_fib
; CHECK-NEXT:    mov.l r1, r6
; CHECK-NEXT:    add #-2, r7, r1
; CHECK-NEXT:    bsr.a _t_fib
; CHECK-NEXT:    add r6, r1
; CHECK-NEXT:    rtsd #8, r6-r7
entry:
  %small = icmp slt i32 %n, 2
  br i1 %small, label %base, label %rec
base:
  ret i32 %n
rec:
  %n1 = sub i32 %n, 1
  %n2 = sub i32 %n, 2
  %f1 = call i32 @t_fib(i32 %n1)
  %f2 = call i32 @t_fib(i32 %n2)
  %r = add i32 %f1, %f2
  ret i32 %r
}

