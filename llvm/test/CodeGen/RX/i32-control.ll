target triple = "rx-none-elf"

@g_sink = global i32 0

define i32 @t_collatz(i32 %n) {
; CHECK-LABEL: t_collatz:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    mov.l r1, r2
; CHECK-NEXT:    mov.l #0, r1
; CHECK-NEXT:    cmp #2, r2
; CHECK-NEXT:    bgeu .LBB0_2
; CHECK-NEXT:    bra .LBB0_4
; CHECK-NEXT:  .LBB0_1: ; %oddb
; CHECK-NEXT:    ; in Loop: Header=BB0_2 Depth=1
; CHECK-NEXT:    mul #3, r2
; CHECK-NEXT:    add #1, r2
; CHECK-NEXT:    add #1, r1
; CHECK-NEXT:    cmp #2, r2
; CHECK-NEXT:    bltu .LBB0_4
; CHECK-NEXT:  .LBB0_2: ; %body
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    mov.l r2, r3
; CHECK-NEXT:    and #1, r3
; CHECK-NEXT:    cmp #0, r3
; CHECK-NEXT:    bne .LBB0_1
; CHECK-NEXT:  ; %bb.3: ; %evenb
; CHECK-NEXT:    ; in Loop: Header=BB0_2 Depth=1
; CHECK-NEXT:    shlr #1, r2
; CHECK-NEXT:    add #1, r1
; CHECK-NEXT:    cmp #2, r2
; CHECK-NEXT:    bgeu .LBB0_2
; CHECK-NEXT:  .LBB0_4: ; %exit
; CHECK-NEXT:    rts
entry:
  br label %loop
loop:
  %x = phi i32 [ %n, %entry ], [ %next, %step ]
  %steps = phi i32 [ 0, %entry ], [ %s1, %step ]
  %done = icmp ule i32 %x, 1
  br i1 %done, label %exit, label %body
body:
  %odd = and i32 %x, 1
  %isodd = icmp ne i32 %odd, 0
  br i1 %isodd, label %oddb, label %evenb
oddb:
  %m = mul i32 %x, 3
  %o = add i32 %m, 1
  br label %step
evenb:
  %e = lshr i32 %x, 1
  br label %step
step:
  %next = phi i32 [ %o, %oddb ], [ %e, %evenb ]
  %s1 = add i32 %steps, 1
  br label %loop
exit:
  ret i32 %steps
}

define i32 @t_fib(i32 %n) {
; CHECK-LABEL: t_fib:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    pushm r6-r7
