; float with the FPU. Operations marked nnan ninf in functions that
; allow flushing denormals (#0) use FPU instructions; the others must
; keep IEEE semantics (soft-float libcalls), including for NaNs,
; infinities and denormals. RXv1 needs +fpu; RXv2 adds instructions.

target triple = "rx-none-elf"

