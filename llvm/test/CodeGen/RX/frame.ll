; Prologues and epilogues: the callee-saved registers are saved with one
; pushm (push.l for one register), and rtsd frees the frame, restores
; them and returns.

target triple = "rx-none-elf"

declare void @touch(ptr, i32)

; --- which registers: r6 and r8 used, r7 saved with them (pushm r6-r8)
define i32 @clob_gap(i32 %a) {
; CHECK-LABEL: clob_gap:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pushm r6-r8
; CHECK-NEXT:    add #1, r1
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    mov.l #23130, r6
; CHECK-NEXT:    mov.l #42405, r8
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    rtsd #12, r6-r8
  call void asm sideeffect "mov.l #0x5a5a, r6\0A\09mov.l #0xa5a5, r8", "~{r6},~{r8}"()
  %r = add i32 %a, 1
  ret i32 %r
}

; one register: push.l / rtsd #4, r10-r10
define i32 @clob_one(i32 %a) {
; CHECK-LABEL: clob_one:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    push.l r10
; CHECK-NEXT:    add #2, r1
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    mov.l #4660, r10
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    rtsd #4, r10-r10
  call void asm sideeffect "mov.l #0x1234, r10", "~{r10}"()
  %r = add i32 %a, 2
  ret i32 %r
}

; every callee-saved register
define i32 @clob_all(i32 %a) {
; CHECK-LABEL: clob_all:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pushm r6-r13
; CHECK-NEXT:    add #3, r1
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    mov.l #1, r6
; CHECK-NEXT:    mov.l #2, r7
; CHECK-NEXT:    mov.l #3, r8
; CHECK-NEXT:    mov.l #4, r9
; CHECK-NEXT:    mov.l #5, r10
; CHECK-NEXT:    mov.l #6, r11
; CHECK-NEXT:    mov.l #7, r12
; CHECK-NEXT:    mov.l #8, r13
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    rtsd #32, r6-r13
  call void asm sideeffect "mov.l #1, r6\0A\09mov.l #2, r7\0A\09mov.l #3, r8\0A\09mov.l #4, r9\0A\09mov.l #5, r10\0A\09mov.l #6, r11\0A\09mov.l #7, r12\0A\09mov.l #8, r13", "~{r6},~{r7},~{r8},~{r9},~{r10},~{r11},~{r12},~{r13}"()
  %r = add i32 %a, 3
  ret i32 %r
}

; no callee-saved registers, locals only: rtsd #imm
define i32 @locals_only() {
; CHECK-LABEL: locals_only:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    add #-64, r0, r0
; CHECK-NEXT:    add #0, r0, r1
; CHECK-NEXT:    mov.l #16, r2
; CHECK-NEXT:    bsr.a _touch
; CHECK-NEXT:    mov.l 20[r0], r1
; CHECK-NEXT:    rtsd #64
  %p = alloca [16 x i32]
  call void @touch(ptr %p, i32 16)
  %q = getelementptr i32, ptr %p, i32 5
  %v = load i32, ptr %q
  ret i32 %v
}

; --- frame sizes around rtsd's limit of 1020 bytes (locals + registers;
; %n is kept in r8, so r6-r8 are saved)
; 1008 + 12 = 1020: rtsd #1020, r6-r8
define i32 @frame_1020(i32 %n) {
; CHECK-LABEL: frame_1020:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pushm r6-r8
; CHECK-NEXT:    add #-1008, r0, r0
; CHECK-NEXT:    mov.l r1, r8
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    mov.l #0, r6
; CHECK-NEXT:    mov.l #0, r7
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    add #0, r0, r6
; CHECK-NEXT:    mov.l r6, r1
; CHECK-NEXT:    mov.l #252, r2
; CHECK-NEXT:    bsr.a _touch
; CHECK-NEXT:    shll #2, r8, r1
; CHECK-NEXT:    add r6, r1
; CHECK-NEXT:    mov.l [r1], r1
; CHECK-NEXT:    rtsd #1020, r6-r8
  %p = alloca [252 x i32]
  call void asm sideeffect "mov.l #0, r6\0A\09mov.l #0, r7", "~{r6},~{r7}"()
  call void @touch(ptr %p, i32 252)
  %q = getelementptr i32, ptr %p, i32 %n
  %v = load i32, ptr %q
  ret i32 %v
}

; 1012 + 12 = 1024: add #1012, r0 then rtsd #12, r6-r8
define i32 @frame_1024(i32 %n) {
; CHECK-LABEL: frame_1024:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pushm r6-r8
; CHECK-NEXT:    add #-1012, r0, r0
; CHECK-NEXT:    mov.l r1, r8
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    mov.l #0, r6
; CHECK-NEXT:    mov.l #0, r7
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    add #0, r0, r6
; CHECK-NEXT:    mov.l r6, r1
; CHECK-NEXT:    mov.l #253, r2
; CHECK-NEXT:    bsr.a _touch
; CHECK-NEXT:    shll #2, r8, r1
; CHECK-NEXT:    add r6, r1
; CHECK-NEXT:    mov.l [r1], r1
; CHECK-NEXT:    add #1012, r0, r0
; CHECK-NEXT:    rtsd #12, r6-r8
  %p = alloca [253 x i32]
  call void asm sideeffect "mov.l #0, r6\0A\09mov.l #0, r7", "~{r6},~{r7}"()
  call void @touch(ptr %p, i32 253)
  %q = getelementptr i32, ptr %p, i32 %n
  %v = load i32, ptr %q
  ret i32 %v
}

; 1024 bytes and no registers: add #1024, r0 then rts
define i32 @frame_big() {
; CHECK-LABEL: frame_big:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    add #-1024, r0, r0
; CHECK-NEXT:    add #0, r0, r1
; CHECK-NEXT:    mov.l #256, r2
; CHECK-NEXT:    bsr.a _touch
; CHECK-NEXT:    mov.l 1020[r0], r1
; CHECK-NEXT:    add #1024, r0, r0
; CHECK-NEXT:    rts
  %p = alloca [256 x i32]
  call void @touch(ptr %p, i32 256)
  %q = getelementptr i32, ptr %p, i32 255
  %v = load i32, ptr %q
  ret i32 %v
}

; --- an epilogue in the middle of the function: the early return is laid
; out before the rest, so the CFI after its add needs .cfi_remember_state /
; .cfi_restore_state around it (1012 + 12 bytes, r6-r8)
define i32 @early_1024(i32 %n) {
; CHECK-LABEL: early_1024:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pushm r6-r8
; CHECK-NEXT:    add #-1012, r0, r0
; CHECK-NEXT:    mov.l r1, r8
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    mov.l #0, r6
; CHECK-NEXT:    mov.l #0, r7
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    add #0, r0, r1
; CHECK-NEXT:    mov.l #253, r2
; CHECK-NEXT:    bsr.a _touch
; CHECK-NEXT:    cmp #15, r8
; CHECK-NEXT:    bgtu .LBB7_2
; CHECK-NEXT:  ; %bb.1: ; %early
; CHECK-NEXT:    shll #2, r8, r1
; CHECK-NEXT:    add #0, r0, r2
; CHECK-NEXT:    add r2, r1
; CHECK-NEXT:    mov.l [r1], r1
; CHECK-NEXT:    add #1012, r0, r0
; CHECK-NEXT:    rtsd #12, r6-r8
; CHECK-NEXT:  .LBB7_2: ; %late
; CHECK-NEXT:    add #0, r0, r1
; CHECK-NEXT:    mov.l r8, r2
; CHECK-NEXT:    bsr.a _touch
; CHECK-NEXT:    mov.l 4[r0], r1
; CHECK-NEXT:    add r8, r1
; CHECK-NEXT:    add #1012, r0, r0
; CHECK-NEXT:    rtsd #12, r6-r8
  %p = alloca [253 x i32]
  call void asm sideeffect "mov.l #0, r6\0A\09mov.l #0, r7", "~{r6},~{r7}"()
  call void @touch(ptr %p, i32 253)
  %c = icmp ult i32 %n, 16
  br i1 %c, label %early, label %late, !prof !0
early:
  %q = getelementptr i32, ptr %p, i32 %n
  %v = load i32, ptr %q
  ret i32 %v
late:
  call void @touch(ptr %p, i32 %n)
  %q2 = getelementptr i32, ptr %p, i32 1
  %v2 = load i32, ptr %q2
  %r = add i32 %v2, %n
  ret i32 %r
}

; the same with no registers (add #1024, r0 then rts on both paths)
define i32 @early_big(i32 %n) {
; CHECK-LABEL: early_big:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    push.l r6
; CHECK-NEXT:    add #-1024, r0, r0
; CHECK-NEXT:    mov.l r1, r6
; CHECK-NEXT:    add #0, r0, r1
; CHECK-NEXT:    mov.l #256, r2
; CHECK-NEXT:    bsr.a _touch
; CHECK-NEXT:    cmp #15, r6
; CHECK-NEXT:    bgtu .LBB8_2
; CHECK-NEXT:  ; %bb.1: ; %early
; CHECK-NEXT:    shll #2, r6, r1
; CHECK-NEXT:    add #0, r0, r2
; CHECK-NEXT:    add r2, r1
; CHECK-NEXT:    mov.l [r1], r1
; CHECK-NEXT:    add #1024, r0, r0
; CHECK-NEXT:    rtsd #4, r6-r6
; CHECK-NEXT:  .LBB8_2: ; %late
; CHECK-NEXT:    add #0, r0, r1
; CHECK-NEXT:    mov.l r6, r2
; CHECK-NEXT:    bsr.a _touch
; CHECK-NEXT:    mov.l 8[r0], r1
; CHECK-NEXT:    sub r6, r1
; CHECK-NEXT:    add #1024, r0, r0
; CHECK-NEXT:    rtsd #4, r6-r6
  %p = alloca [256 x i32]
  call void @touch(ptr %p, i32 256)
  %c = icmp ult i32 %n, 16
  br i1 %c, label %early, label %late, !prof !0
early:
  %q = getelementptr i32, ptr %p, i32 %n
  %v = load i32, ptr %q
  ret i32 %v
late:
  call void @touch(ptr %p, i32 %n)
  %q2 = getelementptr i32, ptr %p, i32 2
  %v2 = load i32, ptr %q2
  %r = sub i32 %v2, %n
  ret i32 %r
}

; and a small frame: rtsd alone moves SP, so the epilogue has no CFI
define i32 @early_small(i32 %n) {
; CHECK-LABEL: early_small:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pushm r6-r7
; CHECK-NEXT:    add #-32, r0, r0
; CHECK-NEXT:    mov.l r1, r7
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    mov.l #0, r6
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    add #0, r0, r1
; CHECK-NEXT:    mov.l #8, r2
; CHECK-NEXT:    bsr.a _touch
; CHECK-NEXT:    cmp #7, r7
; CHECK-NEXT:    bgtu .LBB9_2
; CHECK-NEXT:  ; %bb.1: ; %early
; CHECK-NEXT:    shll #2, r7, r1
; CHECK-NEXT:    add #0, r0, r2
; CHECK-NEXT:    add r2, r1
; CHECK-NEXT:    mov.l [r1], r1
; CHECK-NEXT:    rtsd #40, r6-r7
; CHECK-NEXT:  .LBB9_2: ; %late
; CHECK-NEXT:    add #0, r0, r1
; CHECK-NEXT:    mov.l #1, r2
; CHECK-NEXT:    bsr.a _touch
; CHECK-NEXT:    mov.l 12[r0], r1
; CHECK-NEXT:    mul r7, r1
; CHECK-NEXT:    rtsd #40, r6-r7
  %p = alloca [8 x i32]
  call void asm sideeffect "mov.l #0, r6", "~{r6}"()
  call void @touch(ptr %p, i32 8)
  %c = icmp ult i32 %n, 8
  br i1 %c, label %early, label %late, !prof !0
early:
  %q = getelementptr i32, ptr %p, i32 %n
  %v = load i32, ptr %q
  ret i32 %v
late:
  call void @touch(ptr %p, i32 1)
  %q2 = getelementptr i32, ptr %p, i32 3
  %v2 = load i32, ptr %q2
  %r = mul i32 %v2, %n
  ret i32 %r
}

; --- incoming arguments on the stack, above the saved range (r6-r9, with
; r7 / r8 filled in) and the locals
define i32 @stack_args(i32 %a, i32 %b, i32 %c, i32 %d, i32 %e, i32 %f) {
; CHECK-LABEL: stack_args:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pushm r6-r9
; CHECK-NEXT:    add #-32, r0, r0
; CHECK-NEXT:    mov.l r4, r7
; CHECK-NEXT:    mov.l r1, r8
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    mov.l #0, r6
; CHECK-NEXT:    mov.l #0, r9
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    add #0, r0, r1
; CHECK-NEXT:    mov.l #8, r2
; CHECK-NEXT:    bsr.a _touch
; CHECK-NEXT:    mov.l 56[r0], r1
; CHECK-NEXT:    mul #10000, r1
; CHECK-NEXT:    mov.l 52[r0], r2
; CHECK-NEXT:    mul #100, r2
; CHECK-NEXT:    add r2, r1
; CHECK-NEXT:    add r8, r1
; CHECK-NEXT:    add r7, r1
; CHECK-NEXT:    mov.l 12[r0], r2
; CHECK-NEXT:    add r2, r1
; CHECK-NEXT:    rtsd #48, r6-r9
  %p = alloca [8 x i32]
  call void asm sideeffect "mov.l #0, r6\0A\09mov.l #0, r9", "~{r6},~{r9}"()
  call void @touch(ptr %p, i32 8)
  %q = getelementptr i32, ptr %p, i32 3
  %v = load i32, ptr %q
  %s1 = mul i32 %e, 100
  %s2 = mul i32 %f, 10000
  %s3 = add i32 %s1, %s2
  %s4 = add i32 %s3, %a
  %s5 = add i32 %s4, %d
  %s6 = add i32 %s5, %v
  ret i32 %s6
}

; --- an i64 result in R1:R2 through rtsd (r11 and the registers %a and %n
; are kept in, with the ones between filled in)
define i64 @ret64(i64 %a, i32 %n) {
; CHECK-LABEL: ret64:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pushm r6-r11
; CHECK-NEXT:    add #-16, r0, r0
; CHECK-NEXT:    mov.l r3, r6
; CHECK-NEXT:    mov.l r2, r7
; CHECK-NEXT:    mov.l r1, r8
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    mov.l #0, r11
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    add #0, r0, r9
; CHECK-NEXT:    mov.l r9, r1
; CHECK-NEXT:    mov.l #4, r2
; CHECK-NEXT:    bsr.a _touch
; CHECK-NEXT:    shll #2, r6, r1
; CHECK-NEXT:    add r9, r1
; CHECK-NEXT:    mov.l [r1], r1
; CHECK-NEXT:    add r8, r1
; CHECK-NEXT:    adc #0, r7
; CHECK-NEXT:    mov.l r7, r2
; CHECK-NEXT:    rtsd #40, r6-r11
  %p = alloca [4 x i32]
  call void asm sideeffect "mov.l #0, r11", "~{r11}"()
  call void @touch(ptr %p, i32 4)
  %q = getelementptr i32, ptr %p, i32 %n
  %v = load i32, ptr %q
  %w = zext i32 %v to i64
  %r = add i64 %a, %w
  ret i64 %r
}

; the early return is the likely path, so it is laid out first
!0 = !{!"branch_weights", i32 1000, i32 1}
