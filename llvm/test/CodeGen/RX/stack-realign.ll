; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=rx-none-elf -mcpu=rxv1 < %s | FileCheck %s
; RUN: llc -mtriple=rx-none-elf -mcpu=rxv3 < %s | FileCheck %s

; The stack is 4-byte aligned. A stack object aligned beyond that makes the
; prologue realign SP: R6 keeps the SP from after the pushm (it addresses
; the incoming stack arguments, since RX displacements are positive only)
; and "and #-align, r0" aligns SP, which addresses the locals. Before, SP was
; never realigned, and the object got a 4-aligned address while LLVM folded
; its low address bits as zero.

declare void @use(ptr)

; The low bits of an align 16 address are known to be zero.
define i32 @tag_bits() {
; CHECK-LABEL: tag_bits:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    push.l r6
; CHECK-NEXT:    mov.l r0, r6
; CHECK-NEXT:    add #-24, r0, r0
; CHECK-NEXT:    and #-16, r0
; CHECK-NEXT:    add #0, r0, r1
; CHECK-NEXT:    bsr.a _use
; CHECK-NEXT:    mov.l #0, r1
; CHECK-NEXT:    mov.l r6, r0
; CHECK-NEXT:    rtsd #4, r6-r6
  %p = alloca [4 x i32], align 16
  call void @use(ptr %p)
  %a = ptrtoint ptr %p to i32
  %t = and i32 %a, 15
  ret i32 %t
}

define void @align8() {
; CHECK-LABEL: align8:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    push.l r6
; CHECK-NEXT:    mov.l r0, r6
; CHECK-NEXT:    add #-8, r0, r0
; CHECK-NEXT:    and #-8, r0
; CHECK-NEXT:    add #0, r0, r1
; CHECK-NEXT:    bsr.a _use
; CHECK-NEXT:    mov.l r6, r0
; CHECK-NEXT:    rtsd #4, r6-r6
  %p = alloca i64, align 8
  call void @use(ptr %p)
  ret void
}

define void @align64() {
; CHECK-LABEL: align64:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    push.l r6
; CHECK-NEXT:    mov.l r0, r6
; CHECK-NEXT:    add #-120, r0, r0
; CHECK-NEXT:    and #-64, r0
; CHECK-NEXT:    add #0, r0, r1
; CHECK-NEXT:    bsr.a _use
; CHECK-NEXT:    mov.l r6, r0
; CHECK-NEXT:    rtsd #4, r6-r6
  %p = alloca [16 x i32], align 64
  call void @use(ptr %p)
  ret void
}

; The fifth argument is on the stack: it is addressed off R6.
define i32 @stack_arg(i32 %a, i32 %b, i32 %c, i32 %d, i32 %e) {
; CHECK-LABEL: stack_arg:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pushm r6-r7
; CHECK-NEXT:    mov.l r0, r6
; CHECK-NEXT:    add #-20, r0, r0
; CHECK-NEXT:    and #-16, r0
; CHECK-NEXT:    mov.l r1, r7
; CHECK-NEXT:    add #0, r0, r1
; CHECK-NEXT:    bsr.a _use
; CHECK-NEXT:    mov.l 12[r6], r1
; CHECK-NEXT:    add r7, r1
; CHECK-NEXT:    mov.l r6, r0
; CHECK-NEXT:    rtsd #8, r6-r7
  %p = alloca [4 x i32], align 16
  call void @use(ptr %p)
  %s = add i32 %e, %a
  ret i32 %s
}

; With a dynamic alloca SP moves too, so R7 is a base pointer that holds the
; aligned SP.
define void @with_dynamic(i32 %n) {
; CHECK-LABEL: with_dynamic:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pushm r6-r8
; CHECK-NEXT:    mov.l r0, r6
; CHECK-NEXT:    add #-16, r0, r0
; CHECK-NEXT:    and #-16, r0
; CHECK-NEXT:    mov.l r0, r7
; CHECK-NEXT:    shll #2, r1
; CHECK-NEXT:    sub r1, r0, r8
; CHECK-NEXT:    mov.l r8, r0
; CHECK-NEXT:    add #0, r7, r1
; CHECK-NEXT:    bsr.a _use
; CHECK-NEXT:    mov.l r8, r1
; CHECK-NEXT:    bsr.a _use
; CHECK-NEXT:    mov.l r6, r0
; CHECK-NEXT:    rtsd #12, r6-r8
  %p = alloca [4 x i32], align 16
  %q = alloca i32, i32 %n, align 4
  call void @use(ptr %p)
  call void @use(ptr %q)
  ret void
}

; No over-aligned object: no realignment.
define void @no_realign() {
; CHECK-LABEL: no_realign:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    add #-4, r0, r0
; CHECK-NEXT:    add #0, r0, r1
; CHECK-NEXT:    bsr.a _use
; CHECK-NEXT:    rtsd #4
  %p = alloca i32, align 4
  call void @use(ptr %p)
  ret void
}
