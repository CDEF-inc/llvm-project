; CHECK-NEXT:    dmov.d 36[r0], dr0
; CHECK-NEXT:    dmul dr0, dr3, dr2
; CHECK-NEXT:    dsub dr2, dr1, dr1
; CHECK-NEXT:    dmov.d dr1, [r0] ; 8-byte Folded Spill
; CHECK-NEXT:    dmov.d 16[r0], dr1 ; 8-byte Folded Reload
; CHECK-NEXT:    dmov.d 8[r0], dr2 ; 8-byte Folded Reload
; CHECK-NEXT:    dadd dr2, dr1, dr1
; CHECK-NEXT:    dsub dr0, dr3, dr0
; CHECK-NEXT:    dmul dr0, dr1, dr0
; CHECK-NEXT:    dmov.d [r0], dr1 ; 8-byte Folded Reload
; CHECK-NEXT:    ddiv dr0, dr1, dr0
; CHECK-NEXT:    dadd dr1, dr0, dr0
; CHECK-NEXT:    dmov.l drl0, r1
; CHECK-NEXT:    dmov.l drh0, r2
; CHECK-NEXT:    rtsd #24
