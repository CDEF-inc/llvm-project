; Variadic function definitions (va_start / va_arg / va_copy): all
; arguments of a variadic function are on the stack, 4-byte aligned,
; including the last named one.

target triple = "rx-none-elf"

declare void @llvm.va_start.p0(ptr)
declare void @llvm.va_end.p0(ptr)
declare void @llvm.va_copy.p0(ptr, ptr)
declare i32 @c_vsum(i32, ptr)

; int va_sum(int n, ...): n ints
define i32 @va_sum(i32 %n, ...) {
; CHECK-LABEL: va_sum:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    add #-4, r0, r0
; CHECK-NEXT:    add #12, r0, r1
; CHECK-NEXT:    mov.l r1, [r0]
; CHECK-NEXT:    mov.l #0, r1
; CHECK-NEXT:    mov.l 8[r0], r2
; CHECK-NEXT:    mov.l #0, r3
; CHECK-NEXT:    cmp r2, r3
; CHECK-NEXT:    bge .LBB0_2
; CHECK-NEXT:  .LBB0_1: ; %body
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    mov.l [r0], r4
; CHECK-NEXT:    add #3, r4
; CHECK-NEXT:    and #-4, r4
; CHECK-NEXT:    add #4, r4, r5
; CHECK-NEXT:    mov.l r5, [r0]
; CHECK-NEXT:    mov.l [r4], r4
; CHECK-NEXT:    add r4, r1
; CHECK-NEXT:    add #1, r3
; CHECK-NEXT:    cmp r2, r3
; CHECK-NEXT:    blt .LBB0_1
; CHECK-NEXT:  .LBB0_2: ; %done
; CHECK-NEXT:    rtsd #4
entry:
  %ap = alloca ptr
  call void @llvm.va_start.p0(ptr %ap)
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %body ]
  %s = phi i32 [ 0, %entry ], [ %s1, %body ]
  %c = icmp slt i32 %i, %n
  br i1 %c, label %body, label %done
body:
  %v = va_arg ptr %ap, i32
  %s1 = add i32 %s, %v
  %i1 = add i32 %i, 1
  br label %loop
done:
  call void @llvm.va_end.p0(ptr %ap)
  ret i32 %s
}

