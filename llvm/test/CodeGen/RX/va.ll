; CHECK-NEXT:    mov.l #0, r1
; CHECK-NEXT:    mov.l 16[r0], r6
; CHECK-NEXT:    mov.l #0, r7
; CHECK-NEXT:    mov.l #0, r2
; CHECK-NEXT:    cmp r6, r7
; CHECK-NEXT:    bge .LBB2_2
; CHECK-NEXT:  .LBB2_1: ; %body
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    mov.l [r0], r3
; CHECK-NEXT:    add #3, r3, r4
; CHECK-NEXT:    and #-4, r4
; CHECK-NEXT:    add #4, r4, r3
; CHECK-NEXT:    mov.l r3, [r0]
; CHECK-NEXT:    mov.l [r4], r3
; CHECK-NEXT:    add #8, r4, r5
; CHECK-NEXT:    mov.l r5, [r0]
; CHECK-NEXT:    mov.l 4[r4], r4
; CHECK-NEXT:    bsr.a ___adddf3
; CHECK-NEXT:    add #1, r7
; CHECK-NEXT:    cmp r6, r7
; CHECK-NEXT:    blt .LBB2_1
; CHECK-NEXT:  .LBB2_2: ; %done
; CHECK-NEXT:    rtsd #12, r6-r7
entry:
  %ap = alloca ptr
  call void @llvm.va_start.p0(ptr %ap)
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %body ]
  %s = phi double [ 0.0, %entry ], [ %s1, %body ]
  %c = icmp slt i32 %i, %n
  br i1 %c, label %body, label %done
body:
  %v = va_arg ptr %ap, double
  %s1 = fadd double %s, %v
  %i1 = add i32 %i, 1
