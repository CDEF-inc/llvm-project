; va_copy: read the first argument twice
define i32 @va_twice(i32 %n, ...) {
; CHECK-LABEL: va_twice:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    add #-8, r0, r0
; CHECK-NEXT:    add #16, r0, r1
; CHECK-NEXT:    mov.l r1, [r0]
; CHECK-NEXT:    add #7, r1, r2
; CHECK-NEXT:    and #-4, r2
; CHECK-NEXT:    add #4, r2, r3
; CHECK-NEXT:    mov.l r3, 4[r0]
; CHECK-NEXT:    mov.l [r2], r2
; CHECK-NEXT:    add #4, r1
; CHECK-NEXT:    mov.l r1, [r0]
; CHECK-NEXT:    mov.l 16[r0], r1
; CHECK-NEXT:    add r1, r2
; CHECK-NEXT:    mul #1000, r1
; CHECK-NEXT:    add r2, r1
; CHECK-NEXT:    rtsd #8
  %ap = alloca ptr
  %aq = alloca ptr
  call void @llvm.va_start.p0(ptr %ap)
  call void @llvm.va_copy.p0(ptr %aq, ptr %ap)
  %x = va_arg ptr %ap, i32
  %y = va_arg ptr %ap, i32
  %z = va_arg ptr %aq, i32
  call void @llvm.va_end.p0(ptr %aq)
  call void @llvm.va_end.p0(ptr %ap)
  %m = mul i32 %z, 1000
  %s = add i32 %x, %y
  %r = add i32 %s, %m
  ret i32 %r
}

; a va_list passed on to GCC code
define i32 @va_fwd(i32 %n, ...) {
; CHECK-LABEL: va_fwd:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    add #-4, r0, r0
; CHECK-NEXT:    add #12, r0, r2
; CHECK-NEXT:    mov.l r2, [r0]
; CHECK-NEXT:    mov.l 8[r0], r1
; CHECK-NEXT:    bsr.a _c_vsum
; CHECK-NEXT:    rtsd #4
  %ap = alloca ptr
  call void @llvm.va_start.p0(ptr %ap)
  %list = load ptr, ptr %ap
  %r = call i32 @c_vsum(i32 %n, ptr %list)
  call void @llvm.va_end.p0(ptr %ap)
  ret i32 %r
}

; with locals and callee-saved registers, so that the arguments are found
; above them
define i32 @va_frame(i32 %n, ...) {
; CHECK-LABEL: va_frame:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    pushm r6-r9
; CHECK-NEXT:    add #-24, r0, r0
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    mov.l #0, r6
; CHECK-NEXT:    mov.l #0, r9
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    add #48, r0, r1
; CHECK-NEXT:    add #7, r1
; CHECK-NEXT:    and #-4, r1
; CHECK-NEXT:    add #4, r1, r2
; CHECK-NEXT:    mov.l r2, [r0]
; CHECK-NEXT:    mov.l [r1], r1
; CHECK-NEXT:    mov.l 48[r0], r2
; CHECK-NEXT:    mov.l r2, 12[r0]
; CHECK-NEXT:    mov.l 12[r0], r2
; CHECK-NEXT:    sub r1, r2, r1
; CHECK-NEXT:    mov.l 44[r0], r2
; CHECK-NEXT:    add r2, r1
; CHECK-NEXT:    rtsd #40, r6-r9
  %buf = alloca [5 x i32]
  %ap = alloca ptr
  call void asm sideeffect "mov.l #0, r6\0A\09mov.l #0, r9", "~{r6},~{r9}"()
  call void @llvm.va_start.p0(ptr %ap)
  %a = va_arg ptr %ap, i32
  %b = va_arg ptr %ap, i32
  call void @llvm.va_end.p0(ptr %ap)
  %q = getelementptr i32, ptr %buf, i32 2
  store volatile i32 %a, ptr %q
  %v = load volatile i32, ptr %q
  %r = sub i32 %v, %b
  %rn = add i32 %r, %n
  ret i32 %rn
}
