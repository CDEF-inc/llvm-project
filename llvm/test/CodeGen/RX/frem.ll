; frem is a call to fmodf / fmod, with or without the FPU / DFPU. With the
; FPU, f32 frem used to be Expand, and ExpandIRInsts replaced it in IR by a
; loop of frexpf / ldexpf / fmaf / rintf calls; compiler_builtins has no
; frexpf for rx-none-elf, so Rust code that used % on f32 failed to link.

define float @frem_f32(float %a, float %b) {
; CHECK-LABEL: frem_f32:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    bsr.a _fmodf
; CHECK-NEXT:    rts
  %r = frem float %a, %b
  ret float %r
}

define float @frem_f32_fast(float %a, float %b) #0 {
; CHECK-LABEL: frem_f32_fast:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    bsr.a _fmodf
; CHECK-NEXT:    rts
  %r = frem fast float %a, %b
  ret float %r
}

define double @frem_f64(double %a, double %b) {
; CHECK-LABEL: frem_f64:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    bsr.a _fmod
; CHECK-NEXT:    rts
  %r = frem double %a, %b
  ret double %r
}

define double @frem_f64_fast(double %a, double %b) #0 {
; CHECK-LABEL: frem_f64_fast:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    bsr.a _fmod
; CHECK-NEXT:    rts
  %r = frem fast double %a, %b
  ret double %r
}

attributes #0 = { denormal_fpenv(preservesign) }
