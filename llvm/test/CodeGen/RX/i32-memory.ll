}

; Sum of sign-extended bytes, zero-extended bytes and both halves.
define i32 @t_narrow() {
; CHECK-LABEL: t_narrow:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    mov.l #_g_bytes, r1
; CHECK-NEXT:    movu.b 1[r1], r2
; CHECK-NEXT:    mov.b [r1], r3
; CHECK-NEXT:    add r3, r2
; CHECK-NEXT:    movu.b 2[r1], r1
; CHECK-NEXT:    add r2, r1
; CHECK-NEXT:    mov.l #_g_half, r2
; CHECK-NEXT:    mov.w [r2], r3
; CHECK-NEXT:    add r3, r1
; CHECK-NEXT:    movu.w 2[r2], r2
; CHECK-NEXT:    add r2, r1
; CHECK-NEXT:    rts
  %b0 = load i8, ptr @g_bytes
  %p1 = getelementptr i8, ptr @g_bytes, i32 1
  %b1 = load i8, ptr %p1
  %p2 = getelementptr i8, ptr @g_bytes, i32 2
  %b2 = load i8, ptr %p2
  %s0 = sext i8 %b0 to i32
  %s1 = zext i8 %b1 to i32
  %s2 = zext i8 %b2 to i32
  %h0 = load i16, ptr @g_half
  %ph1 = getelementptr i16, ptr @g_half, i32 1
  %h1 = load i16, ptr %ph1
  %x0 = sext i16 %h0 to i32
  %x1 = zext i16 %h1 to i32
  %a = add i32 %s0, %s1
  %b = add i32 %a, %s2
  %c = add i32 %b, %x0
  %d = add i32 %c, %x1
  ret i32 %d
}

; Stores through a pointer argument at several offsets.
define void @t_store(ptr %p, i32 %v) {
; CHECK-LABEL: t_store:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    mov.l r2, 400[r1]
; CHECK-NEXT:    mov.w r2, 6[r1]
; CHECK-NEXT:    mov.b r2, 4[r1]
