; i32 loads, stores and globals.

target triple = "rx-none-elf"

@g_table = global [8 x i32] [i32 1, i32 -2, i32 3, i32 -4, i32 5, i32 -6, i32 7, i32 -8]
@g_counter = global i32 0
@g_bytes = global [4 x i8] [i8 -1, i8 127, i8 -128, i8 1]
@g_half = global [2 x i16] [i16 -32768, i16 32767]


define i32 @t_global_sum() {
; CHECK-LABEL: t_global_sum:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    mov.l #0, r1
; CHECK-NEXT:    mov.l #_g_table, r2
; CHECK-NEXT:    mov.l #0, r3
; CHECK-NEXT:  .LBB0_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    add r2, r3, r4
; CHECK-NEXT:    mov.l [r4], r4
; CHECK-NEXT:    add r4, r1
; CHECK-NEXT:    add #4, r3
; CHECK-NEXT:    cmp #32, r3
; CHECK-NEXT:    bne .LBB0_1
; CHECK-NEXT:  ; %bb.2: ; %exit
; CHECK-NEXT:    rts
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %s = phi i32 [ 0, %entry ], [ %s1, %loop ]
  %p = getelementptr [8 x i32], ptr @g_table, i32 0, i32 %i
  %v = load i32, ptr %p
  %s1 = add i32 %s, %v
  %i1 = add i32 %i, 1
  %c = icmp ne i32 %i1, 8
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %s1
}

define i32 @t_counter(i32 %d) {
; CHECK-LABEL: t_counter:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    mov.l #_g_counter, r2
; CHECK-NEXT:    mov.l [r2], r3
; CHECK-NEXT:    add r3, r1
; CHECK-NEXT:    mov.l r1, [r2]
; CHECK-NEXT:    rts
  %v = load volatile i32, ptr @g_counter
  %n = add i32 %v, %d
  store volatile i32 %n, ptr @g_counter
