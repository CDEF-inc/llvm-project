  store i8 %t8, ptr %q1
  %q2 = getelementptr i8, ptr %p, i32 6
  %t16 = trunc i32 %v to i16
  store i16 %t16, ptr %q2
  %q3 = getelementptr i8, ptr %p, i32 400
  store i32 %v, ptr %q3
