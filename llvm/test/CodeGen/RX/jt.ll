  ]
x0: br label %mid
x1: br label %mid
x2: br label %mid
x3: br label %mid
x4: br label %mid
mid:
  %v = phi i32 [ 100, %x0 ], [ 200, %x1 ], [ 300, %x2 ], [ 400, %x3 ],
               [ 500, %x4 ], [ 0, %entry ]
  switch i32 %y, label %out [
    i32 10, label %y0
    i32 11, label %y1
    i32 12, label %y2
    i32 13, label %y3
    i32 14, label %y4
  ]
