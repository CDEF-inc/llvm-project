; A computed goto: indirectbr to a block address.
@targets = constant [3 x ptr] [ptr blockaddress(@L_goto, %t0),
                               ptr blockaddress(@L_goto, %t1),
                               ptr blockaddress(@L_goto, %t2)]
define i32 @L_goto(i32 %i) {
; CHECK-LABEL: L_goto:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    mov.l #_targets, r2
; CHECK-NEXT:    mov.l [r1, r2], r1
; CHECK-NEXT:    jmp r1
; CHECK-NEXT:  .Ltmp0: ; Block address taken
; CHECK-NEXT:  .LBB6_1: ; %t0
; CHECK-NEXT:    mov.l #7, r1
; CHECK-NEXT:    rts
; CHECK-NEXT:  .Ltmp1: ; Block address taken
; CHECK-NEXT:  .LBB6_2: ; %t2
; CHECK-NEXT:    mov.l #9, r1
; CHECK-NEXT:    rts
; CHECK-NEXT:  .Ltmp2: ; Block address taken
; CHECK-NEXT:  .LBB6_3: ; %t1
; CHECK-NEXT:    mov.l #8, r1
; CHECK-NEXT:    rts
entry:
  %p = getelementptr [3 x ptr], ptr @targets, i32 0, i32 %i
  %t = load ptr, ptr %p
  indirectbr ptr %t, [label %t0, label %t1, label %t2]
t0: ret i32 7
t1: ret i32 8
t2: ret i32 9
}
